{
  "name": "example-with-tailwindcss",
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "vp dev",
    "prebuild": "node scripts/generate-photos-manifest.mjs",
    "build": "vp build",
    "preview": "vp preview",
    "start": "vp preview",
    "check": "tsc --noEmit",
    "optimize:photos": "node scripts/optimize-images.mjs",
    "optimize:photos:max1600": "MAX_WIDTH=1600 QUALITY=80 node scripts/optimize-images.mjs",
    "optimize:photos:1080p": "MAX_WIDTH=1920 MAX_HEIGHT=1080 QUALITY=80 node scripts/optimize-images.mjs",
    "generate:photos-manifest": "node scripts/generate-photos-manifest.mjs"
  },
  "dependencies": {
    "@solidjs/router": "^0.16.1",
    "@tailwindcss/typography": "^0.5.16",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.2.0",
    "autoprefixer": "^10.4.20",
    "cloudinary": "^1.41.3",
    "exifr": "^7.1.3",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "solid-js": "^1.9.11",
    "tailwindcss": "^3.4.15"
  },
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead",
    "not IE 11"
  ],
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@voidzero-dev/vite-plus-core": "^0.1.12",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.11",
    "vite-plus": "^0.1.12"
  }
}
